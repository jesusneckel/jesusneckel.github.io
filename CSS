body {
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  background-color: #121212;
  color: #d4d4d4;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  margin: 0;
}

.code-container {
  width: 90%;
  max-width: 800px;
  background-color: #1e1e1e;
  border-radius: 8px;
  overflow: hidden;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6);
}

.tabs {
  display: flex;
  background-color: #252526;
  border-bottom: 1px solid #3c3c3c;
}

.tab-btn {
  background-color: inherit;
  border: none;
  outline: none;
  cursor: pointer;
  padding: 14px 24px;
  color: #858585;
  font-size: 14px;
  font-weight: bold;
  transition: all 0.2s ease;
}

.tab-btn:hover {
  background-color: #2a2d2e;
  color: #ffffff;
}

.tab-btn.active {
  background-color: #1e1e1e;
  color: #007acc;
  border-top: 2px solid #007acc;
}

.tab-content {
  display: none;
  padding: 20px;
}

.tab-content.active {
  display: block;
}

pre {
  margin: 0;
  font-family: 'Consolas', 'Courier New', Courier, monospace;
  font-size: 14px;
  line-height: 1.6;
  color: #dcdcaa;
  overflow-x: auto;
}
